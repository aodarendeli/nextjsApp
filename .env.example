# Copy this file to .env.development or .env.production and update the values

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO — canonical origin used in sitemap, robots, canonical & hreflang tags (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://freestudio.site
# Google Search Console / Yandex Webmaster "HTML tag" verification codes (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Analytics and Monitoring
NEXT_PUBLIC_GA_ID=

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Mail (contact & quote forms) — server-side only, never commit real values
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@freestudio.site
SMTP_PASS=
# Optional: defaults to SMTP_USER / info@freestudio.site
SMTP_FROM=
CONTACT_TO=info@freestudio.site
